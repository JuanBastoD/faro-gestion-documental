# Plantilla de variables de entorno. Copiar a .env y cambiar las claves:
#   cp .env.example .env
# .env está en .gitignore y NO se sube al repositorio (que es público).
# Los valores de abajo son de ejemplo para desarrollo local con datos ficticios.
# Nunca reutilizar estas claves en la nube ni con datos reales.

# --- PostgreSQL (infra/docker-compose.yml) ---
# Puerto 5433 en el equipo para no chocar con un PostgreSQL local en el 5432.
POSTGRES_USER=faro
POSTGRES_PASSWORD=cambia-esta-clave-local
POSTGRES_DB=faro
POSTGRES_PORT=5433

# --- Almacén de archivos compatible con S3 (infra/docker-compose.yml) ---
S3_ACCESS_KEY=faro-acceso-local
S3_SECRET_KEY=cambia-esta-clave-s3-local
S3_BUCKET=faro-documentos
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- Para la API (apps/api, issue #6) ---
# Debe coincidir con los valores de PostgreSQL de arriba.
DATABASE_URL=postgresql://faro:cambia-esta-clave-local@localhost:5433/faro
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1

# --- Dónde guarda la API los PDF (issue #10) ---
# disco (por defecto): una carpeta de este equipo, sin Docker (apps/api/almacen-local; una ruta
#     relativa se cuenta desde apps/api). No se sube a git.
# s3: el almacén de arriba (RustFS en local, Cloud Storage en la nube). Con s3, la API exige
#     S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY y S3_SECRET_KEY; arrancar sin ellas falla con un mensaje claro.
# ALMACEN_TIPO=disco
# ALMACEN_RUTA=almacen-local

# --- Siembra de desarrollo (npm run db:seed -w apps/api, issue #8) ---
# Clave de los usuarios ficticios admin.demo, editor.demo y consulta.demo (mínimo 12 caracteres).
# Solo para tu equipo: nunca la uses en la nube ni con datos reales.
SEMILLA_CLAVE=clave-demo-local-2026

# --- Pruebas de integración ---
# Por defecto usan una base aparte: el nombre de la de DATABASE_URL más "_test" (faro_test).
# Se crea sola. Si defines esta variable, el nombre de la base debe terminar en _test,
# porque las pruebas vacían sus tablas.
# DATABASE_URL_TEST=postgresql://faro:cambia-esta-clave-local@localhost:5433/faro_test
